+
+// Stable fake Steam2 IDs for fake clients.
+// Uses the same FNV-1a/name-based idea as YaPB fake SteamIDs, so a bot with
+// the same name keeps the same ID after reconnect/restart. The same helper
+// is also used by PF_GetPlayerAuthId(), so `status` and AMXX see one ID.
+static char g_FakeBotStatusIds[MAX_CLIENTS][32] = {};
+
+static unsigned int Host_FakeBotFnv1a32(const char *text)
+{
+	unsigned int hash = 2166136261u;
+	const unsigned char *p = (const unsigned char *)text;
+
+	while (*p)
+	{
+		hash ^= (unsigned int)(*p++);
+		hash *= 16777619u;
+	}
+
+	return hash;
+}
+
+const char *Host_GetFakeBotStatusId(client_t *client)
+{
+	int slot = (int)(client - g_psvs.clients);
+	if (slot < 0 || slot >= MAX_CLIENTS)
+		return "STEAM_0:1:256";
+
+	unsigned int botNameHash = Host_FakeBotFnv1a32(client->name);
+	unsigned int accountId = botNameHash & 0x00FFFF00u;
+
+	// Match YaPB's Steam2-style fake-ID layout: STEAM_0:1:<name hash mask>.
+	Q_snprintf(g_FakeBotStatusIds[slot], sizeof(g_FakeBotStatusIds[slot]),
+		"STEAM_0:1:%u", accountId);
+
+	return g_FakeBotStatusIds[slot];
+}
